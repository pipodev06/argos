# Obligatoria. Sin default a proposito (contiene credenciales).
DATABASE_URL=postgres://USUARIO:PASSWORD@localhost:5432/argos?sslmode=disable

# Opcional. Default 127.0.0.1:8080 (solo loopback). Con auth de dashboard ya se puede
# exponer, pero siempre detras de HTTPS (proxy inverso o ARGOS_TLS_CERT/KEY).
# ARGOS_LISTEN_ADDR=127.0.0.1:8080

# URL con la que los usuarios abren el dashboard (esquema://host[:puerto], sin ruta).
# Vacia = solo se aceptan Host localhost/127.0.0.1/::1 (allowlist contra DNS rebinding).
# Si es https se envia HSTS y se confia en ese Origin pa CSRF.
# ARGOS_PUBLIC_URL=https://argos.example.com

# Directorio con los binarios del agente (lo genera scripts/build-agent.sh: dist/agent). Activa /install.sh,
# /install.ps1, /dl/* y los comandos de instalacion del dashboard (estos ademas exigen ARGOS_PUBLIC_URL https,
# o http://localhost en desarrollo). Debe ser de solo lectura para el usuario del server. Vacio = desactivado.
# ARGOS_AGENT_DIST_DIR=/opt/argos/dist/agent

# Proxies inversos de confianza (IPs o CIDRs, separados por comas). Solo de ellos se lee
# X-Forwarded-For pa el rate limit y la auditoria. Vacio = la IP sale siempre de RemoteAddr.
# ARGOS_TRUSTED_PROXIES=10.0.0.0/8,192.168.1.5

# HTTPS directo en el server (ambas o ninguna). Alternativa: proxy inverso que termine TLS.
# ARGOS_TLS_CERT=/etc/argos/tls/fullchain.pem
# ARGOS_TLS_KEY=/etc/argos/tls/privkey.pem

# Dias que se conserva audit_log (minimo 30, default 180).
# ARGOS_AUDIT_RETENTION_DAYS=180

# Deteccion de hosts caidos: un host up sin reportar por mas de ARGOS_HOST_DOWN_AFTER pasa
# a down si su grupo es "siempre encendido" (always_on) o a offline si no (hosts sin grupo: offline).
# Un grupo puede tener su propio umbral (down_after_seconds); este es el global (minimo 30s, default 2m;
# el agente reporta cada 30s por defecto). El detector corre cada ARGOS_HOST_CHECK_INTERVAL (minimo 1s,
# no mayor que DOWN_AFTER; default 15s).
# Formato de duracion de Go: 30s, 2m, 1h.
# ARGOS_HOST_DOWN_AFTER=2m
# ARGOS_HOST_CHECK_INTERVAL=15s

# Retencion de metricas (dias). El server particiona `metrics` y `service_checks` por dia UTC y borra
# las particiones vencidas; ademas guarda un resumen por hora de cada host (`metrics_hourly`).
# Crudo: default 30, minimo 8 (el ingest acepta muestras de hasta 7 dias atras).
# Resumenes por hora: default 400, debe ser >= la retencion cruda. Chequeos de servicio: default 14, minimo 8.
# Una particion cruda solo se borra si su resumen por hora ya esta calculado.
# ARGOS_METRICS_RETENTION_DAYS=30
# ARGOS_METRICS_HOURLY_RETENTION_DAYS=400
# ARGOS_SERVICE_CHECKS_RETENTION_DAYS=14
# Uso de disco por montaje (tabla `disk_samples`, una muestra cada ~5 min por host segun ARGOS_DISK_INTERVAL
# del agente): dias que se conserva (default 30, minimo 8). No tiene resumen por hora.
# ARGOS_DISK_RETENTION_DAYS=30
# Cada cuanto corre el mantenimiento (crear particiones, resumir, borrar). Default 5m, minimo 5s.
# ARGOS_METRICS_MAINTENANCE_INTERVAL=5m

# Alertas. El evaluador corre cada ARGOS_ALERT_EVAL_INTERVAL (default 15s, minimo 1s) y espera ARGOS_HOST_DOWN_AFTER
# tras arrancar antes del primer ciclo (los agentes necesitan ponerse al dia). Con varias instancias solo una evalua.
# Retencion (dias): historial de cambios de estado de hosts (default 180, minimo 30), alertas resueltas y ventanas de
# mantenimiento terminadas (default 365, minimo 30), entregas de notificaciones terminadas (default 30, minimo 7).
# ARGOS_ALERT_EVAL_INTERVAL=15s
# ARGOS_HOST_EVENTS_RETENTION_DAYS=180
# ARGOS_ALERTS_RETENTION_DAYS=365
# ARGOS_NOTIFICATIONS_RETENTION_DAYS=30
# Chequeos de servicio: historial de transiciones (default 180, minimo 30). Las muestras de latencia (una cada 15 min)
# siguen ARGOS_SERVICE_CHECKS_RETENTION_DAYS (14); el ultimo estado sin actualizar hace mas de 3 dias se borra.
# ARGOS_SERVICE_EVENTS_RETENTION_DAYS=180

# Canales de notificacion (webhook). Los secretos de los canales (URL con token y secreto HMAC) se guardan cifrados
# con AES-256-GCM. ARGOS_SECRET_KEY es la clave: 32 bytes en base64 (p. ej. `openssl rand -base64 32`). Sin ella no
# se pueden crear canales. Si ya hay canales, el server NO arranca sin la clave ni con una distinta a la que los
# cifro: guardala en un lugar seguro (perderla obliga a borrar y recrear los canales). Nunca se loguea.
# ARGOS_SECRET_KEY=
# Destinos que un webhook puede usar aunque sean IPs internas o usen un puerto distinto de 443 (por defecto solo
# https:443 a IPs publicas). Lista separada por comas de hostnames exactos, IPs o CIDRs. Solo por variable de entorno
# (no hay API pa cambiarla): p. ej. un receptor interno "alertas.miempresa.local,10.20.0.0/16".
# ARGOS_WEBHOOK_ALLOW_HOSTS=
# PEM con CAs adicionales pa verificar el certificado de los destinos webhook (CA interna). Se suman a las del sistema.
# ARGOS_WEBHOOK_CA_FILE=
# Cada cuanto el worker envia las notificaciones pendientes (default 5s, minimo 1s). warn/info esperan 30 s pa
# agruparse; critical sale de inmediato. Los enlaces usan ARGOS_PUBLIC_URL.
# ARGOS_NOTIFY_INTERVAL=5s

# SOLO DESARROLLO sobre http: usa la cookie "argos_sid" sin Secure ni prefijo __Host-.
# Chrome/Firefox/curl aceptan la cookie __Host- Secure en http://localhost: normalmente no hace falta.
# NUNCA en produccion.
# ARGOS_INSECURE_COOKIES=false

# Solo pa tests del store y de httpapi (la BD debe terminar en _test; los tests la vacian).
# ARGOS_TEST_DATABASE_URL=postgres://USUARIO:PASSWORD@localhost:5432/argos_test?sslmode=disable
