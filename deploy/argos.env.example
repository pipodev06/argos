# Configuracion del server de argos (/etc/argos/argos.env, modo 0640 root:argos).
# Formato de systemd EnvironmentFile: KEY=valor, sin comillas ni "export". install-server.sh lo genera solo
# la primera vez; nunca lo sobreescribe.

# Postgres 18, con el rol de RUNTIME (argos_app: DML sin ser dueño del esquema). Contiene la clave de la BD: no la
# pegues en chats ni tickets.
DATABASE_URL=postgres://argos_app:CAMBIAME@127.0.0.1:5432/argos?sslmode=disable
# Con dos roles el server NO migra: `sudo argos-admin migrate` (rol dueño, en /etc/argos/argos-migrate.env 0600 root)
# lo hace en cada instalacion/actualizacion y el server se niega a arrancar si hay migraciones pendientes.
ARGOS_AUTO_MIGRATE=false

# Detras de Caddy/nginx: escucha solo en loopback. Sin proxy (TLS directo) usa 0.0.0.0:8443 y ARGOS_TLS_CERT/KEY.
ARGOS_LISTEN_ADDR=127.0.0.1:8080
# URL con la que la gente abre el dashboard (esquema://host[:puerto]). Alimenta la allowlist de Host y HSTS.
ARGOS_PUBLIC_URL=https://argos.lan
# Proxy inverso de confianza (de el se lee X-Forwarded-For para el rate limit y la auditoria).
ARGOS_TRUSTED_PROXIES=127.0.0.1/32

# Clave que cifra los secretos de los canales (base64 de 32 bytes). ESTABLE: si la pierdes hay que recrear los
# canales. Respaldala fuera del server (junto con este archivo).
ARGOS_SECRET_KEY=

ARGOS_WEB_DIR=/opt/argos/web
ARGOS_AGENT_DIST_DIR=/opt/argos/agent

# Opcionales (valores por defecto entre parentesis):
# ARGOS_HOST_DOWN_AFTER=2m
# ARGOS_METRICS_RETENTION_DAYS=30   # retencion global de detalle (dias, >= 8); cada host/grupo puede tener la suya
# ARGOS_METRICS_HOT_DAYS=8           # ventana de metricas crudas antes de empaquetarlas (>= 8)
# ARGOS_AUDIT_RETENTION_DAYS=...
# ARGOS_WEBHOOK_ALLOW_HOSTS=   # destinos privados permitidos para webhooks
# ARGOS_WEBHOOK_CA_FILE=       # CA interna para verificar webhooks
# ARGOS_TLS_CERT=/etc/argos/tls/cert.pem
# ARGOS_TLS_KEY=/etc/argos/tls/key.pem
