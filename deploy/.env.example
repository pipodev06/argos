# Copia a deploy/.env (chmod 600) y completa. NUNCA subas el .env real a git.

# Dominio publico (registro DNS A hacia la IP del servidor). Sin https:// ni barra final.
DOMAIN=argos.ejemplo.com
# Correo pa Let's Encrypt (avisos de vencimiento).
ACME_EMAIL=admin@ejemplo.com

# Clave de la base de datos. Genera una: openssl rand -hex 24
POSTGRES_PASSWORD=CAMBIAME

# Clave que cifra los secretos de los canales (base64 de 32 bytes): openssl rand -base64 32
# ESTABLE: si la pierdes hay que recrear los canales. Respaldala fuera del servidor.
ARGOS_SECRET_KEY=

# Version que se publica pa los agentes. Debe empezar por digito (genera el .deb). Sube el numero en cada
# actualizacion: los agentes se actualizan cuando cambia.
ARGOS_VERSION=0.1.0

# Respaldos (servicio backup): hora local del servidor (0-23) y dias a conservar.
BACKUP_HOUR=3
BACKUP_KEEP_DAYS=14

# Opcional: nivel de log (debug, info, warn, error). Otras variables: server/.env.example.
# ARGOS_LOG_LEVEL=info
