# Proxy inverso con HTTPS automatico (Let's Encrypt). {$DOMAIN} y {$ACME_EMAIL} vienen del .env via compose.
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip
	# Caddy sustituye X-Forwarded-For por la IP real del cliente; el server solo confia en la red de Caddy.
	reverse_proxy argos-server:8080
}
